# Copia este archivo como .env.local y cambia los valores. NUNCA subas .env.local a git.

# Contraseña del Portal del Barbero
ADMIN_PASSWORD=cambia-esta-clave
# Clave para firmar la cookie de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=genera-una-clave-aleatoria-de-64-caracteres

# Base de datos en la nube (solo producción). Si las dejas vacías,
# la app usa el archivo local data/barberia.db.
# TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
# TURSO_AUTH_TOKEN=
